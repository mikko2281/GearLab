diff --git a/tools/test_compound_native.py b/tools/test_compound_native.py
new file mode 100644
index 0000000..48a2048
--- /dev/null
+++ b/tools/test_compound_native.py
@@ -0,0 +1,31 @@
+"""Exact B-rep validation of compound fixtures emitted by --compound-test."""
+import json, sys
+from pathlib import Path
+root=Path(__file__).resolve().parents[1]
+sys.path.insert(0,str(root/'kernel'))
+import cad_kernel as k
+from transmission_assembly import generate
+folder=Path(sys.argv[1]).resolve()
+spec=json.loads((folder/'compound.assembly.json').read_text(encoding='utf-8-sig'))
+request=dict(Spec=spec,Folder=str(folder/'native'),Path=str(folder/'compound.step'),Mode='assembly_parametric')
+reply=generate(request,k)
+assert reply['Ok']
+request['Mode']='assembly_audit'
+audit=generate(request,k)['Audit']
+(folder/'compound.audit.json').write_text(json.dumps(audit,indent=2),encoding='utf-8')
+assert audit['Complete'],audit
+assert not audit['Pairs'],audit['Pairs']
+print('PASS: compound exact connected solids, STEP and zero intersections')
+if '--variants' in sys.argv:
+    reports=[]
+    for file in sorted(folder.glob('compound-*.assembly.json')):
+        fixture=json.loads(file.read_text(encoding='utf-8-sig'))
+        result=generate(dict(Spec=fixture,Folder=str(folder/'native'),Mode='assembly_audit'),k)['Audit']
+        reports.append(dict(Fixture=file.name,**result))
+        (folder/'compound.variants.audit.json').write_text(json.dumps(reports,indent=2),encoding='utf-8')
+        # Coincident bearing/journal faces can leave micrometre-scale Boolean residue.
+        significant=[p for p in result['Pairs'] if p['Volume']>0.001]
+        result['ToleranceMm3']=0.001
+        result['SignificantPairs']=significant
+        assert result['Complete'] and not significant,(file.name,result)
+        print('PASS:',file.name,flush=True)
diff --git a/tools/test_compound_stl.py b/tools/test_compound_stl.py
new file mode 100644
index 0000000..4be52f2
--- /dev/null
+++ b/tools/test_compound_stl.py
@@ -0,0 +1,19 @@
+﻿import collections,json,struct,sys,zipfile
+from pathlib import Path
+folder=Path(sys.argv[1]);reports=[]
+with zipfile.ZipFile(folder/'compound-print.zip') as zip:
+ assert 'BOM_all_parts.csv' in zip.namelist()
+ for name in zip.namelist():
+  if not name.endswith('.stl'):continue
+  data=zip.read(name);count=struct.unpack_from('<I',data,80)[0];assert len(data)==84+count*50
+  edges=collections.Counter();orientation=collections.Counter();points=[]
+  for i in range(count):
+   v=struct.unpack_from('<12fH',data,84+50*i);tri=[tuple(round(c,5) for c in v[j:j+3]) for j in (3,6,9)];points+=tri
+   for a,b in [(tri[0],tri[1]),(tri[1],tri[2]),(tri[2],tri[0])]:
+    key=tuple(sorted((a,b)));edges[key]+=1;orientation[key]+=1 if a<b else -1
+  bad=sum(n!=2 or orientation[key]!=0 for key,n in edges.items());dims=[max(v[k] for v in points)-min(v[k] for v in points) for k in range(3)]
+  reports.append(dict(File=name,Triangles=count,BadEdges=bad,Dimensions=dims))
+  assert bad==0,(name,bad)
+  assert max(dims)<=256,(name,dims)
+(folder/'compound.stl.audit.json').write_text(json.dumps(dict(Passed=True,Parts=reports),indent=2),encoding='utf-8')
+print('PASS: closed oriented STL, printer envelope and BOM;',len(reports),'parts')
