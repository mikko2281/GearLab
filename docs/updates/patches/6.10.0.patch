  public static List<TrainMaterial> Resolve(TransmissionTrain t){var values=Defaults();if(t.Materials!=null){if(t.Materials.Custom==null||t.Materials.Parts==null||t.Materials.Roles==null||t.Materials.Custom.Count>100)throw new Exception("Некорректный справочник материалов проекта.");var seen=new HashSet<string>();foreach(var m in t.Materials.Custom){Validate(m);if(!seen.Add(m.Name))throw new Exception("Повтор имени материала: "+m.Name);values.RemoveAll(x=>x.Name==m.Name);values.Add(m);}foreach(string name in t.Materials.Roles.Values.Concat(t.Materials.Parts.Values))if(!values.Any(m=>m.Name==name))throw new Exception("Неизвестный материал: "+name);}return values;}
