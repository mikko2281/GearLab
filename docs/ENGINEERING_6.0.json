{
  "Version": "6.1.0",
  "LoadedByApplication": false,
  "Units": {
    "length": "mm",
    "torque": "N*m",
    "force": "N",
    "power": "W",
    "stress": "MPa",
    "speed": "rpm; rack mm/s"
  },
  "Formulas": [
    {
      "Id": "worm",
      "Expression": "i=z2/starts; d1=q*m; d2=z2*m; a=(d1+d2)/2; gamma=atan(starts/q)",
      "Qualification": "Геометрически рассчитано"
    },
    {
      "Id": "worm.losses",
      "Expression": "rho=atan(mu/cos(alpha)); eta=tan(gamma)/tan(gamma+rho); self_lock_estimate=(cos(alpha)*tan(gamma)<=mu)",
      "Qualification": "Приближённая оценка контакта; без подшипников/смазки, не гарантирует удержание"
    },
    {
      "Id": "bevel",
      "Expression": "delta1=atan2(sin(Sigma),z2/z1+cos(Sigma)); delta2=Sigma-delta1; R=m*z1/(2*sin(delta1)); b<=R/3",
      "Qualification": "Пересекающиеся оси, оба конуса острые"
    },
    {
      "Id": "bevel.forces",
      "Expression": "dm1=m*z1-b*sin(delta1); Ft=2000*T1/dm1; Fr1=Ft*tan(alpha)*cos(delta1); Fa1=Ft*tan(alpha)*sin(delta1)",
      "Qualification": "Приближённая статическая оценка; гипоидный случай только эквивалентная коническая оценка"
    },
    {
      "Id": "rv",
      "Expression": "i=1+(z2/z1)*N; nout=nin/i; ncrank=ncarrier-(nin-ncarrier)*z1/z2",
      "Qualification": "Корпус закреплён, выход — водило; НЕ независимое произведение ступеней"
    },
    {
      "Id": "compound.willis",
      "Expression": "zr=zs+za+zb; k=zr*za/(zs*zb); (ws-wc)+k*(wr-wc)=0; wc=(ws+k*wr)/(1+k)",
      "Qualification": "Составные соосные сателлиты A/B, одинаковый модуль"
    },
    {
      "Id": "compound.phase",
      "Expression": "(zs*zb+zr*za) mod (gcd(za,zb)*planet_count)=0",
      "Qualification": "Условие равномерной установки; не контактный анализ"
    },
    {
      "Id": "magnetic",
      "Expression": "segments=p1+p2; nout=-nin*p1/p2",
      "Qualification": "Модулятор неподвижен; предельный момент неизвестен без FEA"
    },
    {
      "Id": "rack",
      "Expression": "r=m*z/2; v_mm_s=n*pi*m*z/60; Ft_input_N=1000*T/r; F_output_N=Ft_input_N*eta",
      "Qualification": "Момент в Н·м, радиус в мм; усилие в Н"
    },
    {
      "Id": "power",
      "Expression": "Pin=T*abs(n)*pi/30; Pout=Pin*eta; Tout=T*abs(i)*eta",
      "Qualification": "Теоретический момент не является допустимым рабочим"
    },
    {
      "Id": "train",
      "Expression": "n_child=n_parent*gain; T_child=T_parent*power_share*abs(i)*eta; sum(outgoing_power_share)<=1",
      "Qualification": "Граф без циклов. После рейки вращательная ступень отклоняется"
    },
    {
      "Id": "train.two_input",
      "Expression": "Tr=k*Ts; wc=(ws+k*wr)/(1+k); Pout=(P1+P2)*eta",
      "Qualification": "Требуется совместимый баланс входных моментов; циркулирующая мощность отклоняется"
    },
    {
      "Id": "bearings",
      "Expression": "R2=F*(load_z-bearing1_z)/(bearing2_z-bearing1_z); R1=F-R2",
      "Qualification": "Балочная статическая оценка. Не расчёт ресурса/преднатяга"
    },
    {
      "Id": "lewis",
      "Expression": "Y=pi*(0.154-0.912/z); sigma_MPa=Ft*K/(b*m*Y); safety=allowable_MPa/sigma_MPa",
      "Qualification": "Только стандартная внешняя прямозубая 20°, z>=17; allowable=0 означает неизвестно"
    },
    {
      "Id": "mass",
      "Expression": "mass_kg=volume_mm3*1e-9*density_kg_m3; COM=sum(volume_i*COM_i)/sum(volume_i)",
      "Qualification": "Геометрическая оценка, габаритные моторы имеют заданную пользователем массу"
    }
  ],
